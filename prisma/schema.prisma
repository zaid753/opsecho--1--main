generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BACKEND_ENGINEER
  FRONTEND_ENGINEER
  SRE_DEVOPS
  SUPPORT_ENGINEER
  PRODUCT_MANAGER
  INCIDENT_COMMANDER
  OBSERVER
  ADMIN
}

enum IncidentStatus {
  CREATED
  ACTIVE
  MITIGATING
  MONITORING
  RESOLVED
  CLOSED
}

enum ActionStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(OBSERVER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  incidentsCreated      Incident[]            @relation("CreatedBy")
  incidentParticipants  IncidentParticipant[]
  actions               Action[]
  approvalsGiven        Approval[]            @relation("ApprovedBy")
  transcripts           Transcript[]
  integrations          Integration[]
}

model Incident {
  id          String         @id @default(uuid())
  roomCode    String         @unique
  title       String
  description String?
  severity    String
  status      IncidentStatus @default(CREATED)
  service     String?
  environment String?
  impact      String?
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy     User                  @relation("CreatedBy", fields: [createdById], references: [id])
  participants  IncidentParticipant[]
  transcripts   Transcript[]
  facts         Fact[]
  hypotheses    Hypothesis[]
  decisions     Decision[]
  actions       Action[]
  timeline      TimelineEvent[]
  conflicts     Conflict[]
  risks         Risk[]
  approvals     Approval[]
}

model IncidentParticipant {
  id          String   @id @default(uuid())
  incidentId  String
  userId      String
  joinedAt    DateTime @default(now())

  incident    Incident @relation(fields: [incidentId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([incidentId, userId])
}

model Transcript {
  id          String   @id @default(uuid())
  incidentId  String
  userId      String?
  userName    String?
  text        String
  timestamp   DateTime @default(now())

  incident    Incident @relation(fields: [incidentId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])
}

model Fact {
  id          String   @id @default(uuid())
  incidentId  String
  description String
  source      String?
  timestamp   DateTime @default(now())

  incident    Incident @relation(fields: [incidentId], references: [id])
}

model Hypothesis {
  id          String   @id @default(uuid())
  incidentId  String
  description String
  proposer    String?
  evidence    String?
  status      String?
  timestamp   DateTime @default(now())

  incident    Incident @relation(fields: [incidentId], references: [id])
}

model Decision {
  id          String   @id @default(uuid())
  incidentId  String
  description String
  decider     String?
  timestamp   DateTime @default(now())

  incident    Incident @relation(fields: [incidentId], references: [id])
}

model Action {
  id          String       @id @default(uuid())
  incidentId  String
  ownerId     String?
  description String
  status      ActionStatus @default(TODO)
  isCritical  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  incident    Incident @relation(fields: [incidentId], references: [id])
  owner       User?    @relation(fields: [ownerId], references: [id])
  approvals   Approval[]
}

model TimelineEvent {
  id          String   @id @default(uuid())
  incidentId  String
  type        String
  description String
  metadata    Json?
  timestamp   DateTime @default(now())

  incident    Incident @relation(fields: [incidentId], references: [id])
}

model Conflict {
  id          String   @id @default(uuid())
  incidentId  String
  description String
  resolution  String?
  timestamp   DateTime @default(now())

  incident    Incident @relation(fields: [incidentId], references: [id])
}

model Risk {
  id          String   @id @default(uuid())
  incidentId  String
  description String
  mitigation  String?
  timestamp   DateTime @default(now())

  incident    Incident @relation(fields: [incidentId], references: [id])
}

model Approval {
  id            String         @id @default(uuid())
  incidentId    String
  actionId      String
  requestedById String
  approvedById  String?
  status        ApprovalStatus @default(PENDING)
  reason        String?
  timestamp     DateTime       @default(now())

  incident      Incident @relation(fields: [incidentId], references: [id])
  action        Action   @relation(fields: [actionId], references: [id])
  approvedBy    User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
}

model Integration {
  id           String   @id @default(uuid())
  userId       String
  provider     String   // "SLACK" or "JIRA"
  accessToken  String
  refreshToken String?
  metadata     Json?    
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id])
  @@unique([userId, provider])
}
